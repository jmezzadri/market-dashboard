{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ \"${VERCEL_GIT_COMMIT_REF#brief/}\" != \"$VERCEL_GIT_COMMIT_REF\" ]; then exit 0; else exit 1; fi",
  "crons": [
    {
      "path": "/api/options-mark-batch",
      "schedule": "30 20 * * 1-5"
    },
    {
      "path": "/api/brief-ensure",
      "schedule": "45 10 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|favicon|.*\\.(?:js|css|json|png|svg|ico|jpg|jpeg|webp|map|woff2?|ttf|otf|eot|txt|xml|webmanifest|html)).*)",
      "destination": "/index.html"
    }
  ]
}
